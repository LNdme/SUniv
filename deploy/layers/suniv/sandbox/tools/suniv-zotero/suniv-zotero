#!/usr/bin/env node
import { readFileSync } from "node:fs";

const CSL_TYPE_TO_ZOTERO = {
  "article-journal": "journalArticle",
  article: "preprint",
  "paper-conference": "conferencePaper",
  chapter: "bookSection",
  book: "book",
  thesis: "thesis",
  report: "report",
  dataset: "dataset",
  webpage: "webpage",
  manuscript: "manuscript",
};

const CONTAINER_FIELD = {
  journalArticle: "publicationTitle",
  conferencePaper: "proceedingsTitle",
  bookSection: "bookTitle",
  preprint: "repository",
  report: "institution",
  thesis: "university",
};

class ZoteroError extends Error {}

function localBase() {
  return process.env.ZOTERO_LOCAL_API || "http://localhost:23119/api";
}

function webKey() {
  return process.env.ZOTERO_API_KEY || "";
}

function userId() {
  return process.env.ZOTERO_USER_ID || "";
}

let selectedGroup = "";

function groupId() {
  return selectedGroup || process.env.ZOTERO_GROUP_ID || "";
}

function library() {
  const group = groupId();
  if (group) return { kind: "group", id: group, webPath: `/groups/${group}`, localPath: `/groups/${group}` };
  return { kind: "personal", id: userId(), webPath: `/users/${userId()}`, localPath: "/users/0" };
}

function webConfigured() {
  return Boolean(webKey() && (groupId() || userId()));
}

function describeAuth() {
  const lines = ["suniv-zotero: no Zotero access is configured. Two paths exist, and they do different things:"];
  lines.push(
    "  local  — Zotero 7 running on this machine with 'Allow other applications on this computer to communicate with Zotero' enabled. Reads the library with no key, and cannot write.",
  );
  lines.push(
    "  web    — ZOTERO_API_KEY plus ZOTERO_USER_ID (personal) or ZOTERO_GROUP_ID (a team library), from zotero.org/settings/keys. Reads and writes, and is the only way to file items into collections.",
  );
  lines.push(
    "A team shares one group library: set ZOTERO_GROUP_ID in the project's own scope, never deployment-wide, or every project on this instance writes into the same library.",
  );
  return lines.join("\n");
}

async function request(url, { method = "GET", headers = {}, body } = {}) {
  const control = new AbortController();
  const timer = setTimeout(() => control.abort(), 20000);
  let response;
  try {
    response = await fetch(url, {
      method,
      body,
      headers: { accept: "application/json", "user-agent": "SUniv/1.0", ...headers },
      signal: control.signal,
    });
  } catch (err) {
    throw new ZoteroError(err.name === "AbortError" ? `${url} timed out` : `${url}: ${err.message}`);
  } finally {
    clearTimeout(timer);
  }

  const text = await response.text();
  if (!response.ok) {
    throw new ZoteroError(`${method} ${url} → HTTP ${response.status} ${response.statusText}\n${text.slice(0, 400)}`);
  }
  if (!text) return null;
  try {
    return JSON.parse(text);
  } catch {
    return text;
  }
}

async function localAvailable() {
  try {
    await request(`${localBase()}${library().localPath}/collections?limit=1`);
    return true;
  } catch {
    return false;
  }
}

async function readApi(path, { preferLocal = true } = {}) {
  const target = library();
  if (preferLocal && (await localAvailable())) {
    return { via: "local", library: target.kind, data: await request(`${localBase()}${target.localPath}${path}`) };
  }
  if (!webConfigured() && target.kind !== "group") throw new ZoteroError(describeAuth());
  const headers = { "Zotero-API-Version": "3" };
  if (webKey()) headers["Zotero-API-Key"] = webKey();
  try {
    return {
      via: "web",
      library: target.kind,
      data: await request(`https://api.zotero.org${target.webPath}${path}`, { headers }),
    };
  } catch (err) {
    if (target.kind === "group" && /HTTP 404/.test(err.message)) {
      throw new ZoteroError(
        `Zotero has no group ${target.id}. The group id is the number in the library's zotero.org URL, not the group's name — check it before assuming the library is empty.`,
      );
    }
    if (target.kind === "group" && /HTTP 40[13]/.test(err.message)) {
      throw new ZoteroError(
        webKey()
          ? `The key is not a member of Zotero group ${target.id}, or lacks access to it. Group membership is granted in the group's settings on zotero.org, separately from the key itself.`
          : `Zotero group ${target.id} is not public, so reading it needs a key.\n\n${describeAuth()}`,
      );
    }
    throw err;
  }
}

async function writeApi(path, payload, method = "POST") {
  if (!webConfigured()) {
    throw new ZoteroError(
      `${describeAuth()}\n\nWriting needs the web path: Zotero's local API is read-only by design, so a key is required to create items, collections or tags.`,
    );
  }
  return await request(`https://api.zotero.org${library().webPath}${path}`, {
    method,
    headers: {
      "Zotero-API-Key": webKey(),
      "Zotero-API-Version": "3",
      "content-type": "application/json",
    },
    body: JSON.stringify(payload),
  });
}

function cslDate(issued) {
  const parts = issued?.["date-parts"]?.[0];
  if (!Array.isArray(parts) || !parts.length) return "";
  return parts
    .slice(0, 3)
    .map((n, i) => (i === 0 ? String(n) : String(n).padStart(2, "0")))
    .join("-");
}

function cslToZotero(item, { collections = [], tags = [] } = {}) {
  const itemType = CSL_TYPE_TO_ZOTERO[item.type] || "journalArticle";
  const zoteroItem = {
    itemType,
    title: item.title || "",
    creators: (item.author || [])
      .map((a) => {
        if (a.family && a.given) return { creatorType: "author", firstName: a.given, lastName: a.family };
        if (a.family) return { creatorType: "author", name: a.family };
        if (a.literal) return { creatorType: "author", name: a.literal };
        return null;
      })
      .filter(Boolean),
    abstractNote: item.abstract || "",
    date: cslDate(item.issued),
    url: item.URL || "",
    volume: item.volume ? String(item.volume) : "",
    issue: item.issue ? String(item.issue) : "",
    pages: item.page ? String(item.page) : "",
    tags: tags.map((tag) => ({ tag })),
    collections,
  };

  const containerField = CONTAINER_FIELD[itemType];
  if (containerField && item["container-title"]) zoteroItem[containerField] = item["container-title"];
  if (itemType === "journalArticle" || itemType === "conferencePaper" || itemType === "preprint") {
    if (item.DOI) zoteroItem.DOI = item.DOI;
  } else if (item.DOI) {
    zoteroItem.extra = `DOI: ${item.DOI}`;
  }

  const grounding = item.custom?.suniv?.grounding;
  if (grounding) {
    const note = `SUniv grounding: ${grounding}`;
    zoteroItem.extra = zoteroItem.extra ? `${zoteroItem.extra}\n${note}` : note;
  }

  for (const key of Object.keys(zoteroItem)) {
    if (zoteroItem[key] === "" || (Array.isArray(zoteroItem[key]) && !zoteroItem[key].length)) {
      if (key !== "collections" && key !== "tags" && key !== "creators") delete zoteroItem[key];
    }
  }
  return zoteroItem;
}

function chunk(items, size) {
  const out = [];
  for (let i = 0; i < items.length; i += size) out.push(items.slice(i, i + size));
  return out;
}

const USAGE = `usage: suniv-zotero <command> [options]

  status                          report which Zotero paths are reachable
  collections                     list collections with their keys
  search <terms>                  search the library
  items [--collection KEY]        list items, optionally within a collection
  add --file items.json           file CSL-JSON works into the library
       [--collection NAME|KEY]    create the collection if the name is unknown
       [--tag TAG]                repeatable
  tag --item KEY --tag TAG        add tags to an existing item

  --group ID                      work in a team's group library instead of the
                                  personal one (or set ZOTERO_GROUP_ID)

Reads prefer Zotero running locally (no key, works offline). Writes always go
through the web API, because Zotero's local API is read-only by design.

A research team shares one group library, so a paper filed by one member is
there for everyone. Set ZOTERO_GROUP_ID in the project's own scope rather than
deployment-wide, or every project on the instance writes into the same library.`;

function parseArgs(argv) {
  const options = { tags: [], _: [] };
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    const next = () => argv[++i];
    switch (arg) {
      case "-h":
      case "--help":
        return { help: true };
      case "--file":
        options.file = next();
        break;
      case "--collection":
        options.collection = next();
        break;
      case "--tag":
        options.tags.push(next());
        break;
      case "--item":
        options.item = next();
        break;
      case "--group":
        options.group = next();
        break;
      default:
        if (arg.startsWith("--")) return { error: `unknown option ${arg}` };
        options._.push(arg);
    }
  }
  return { options };
}

function print(value) {
  process.stdout.write(`${JSON.stringify(value, null, 2)}\n`);
}

async function findCollectionKey(name) {
  const { data } = await readApi("/collections?limit=100");
  const collections = (data || []).map((c) => ({ key: c.key || c.data?.key, name: c.data?.name ?? c.name }));
  const exact = collections.find((c) => c.key === name || c.name === name);
  if (exact) return { key: exact.key, created: false };
  const insensitive = collections.find((c) => String(c.name).toLowerCase() === String(name).toLowerCase());
  if (insensitive) return { key: insensitive.key, created: false };
  const result = await writeApi("/collections", [{ name }]);
  const created = result?.successful?.["0"];
  if (!created) throw new ZoteroError(`could not create collection "${name}": ${JSON.stringify(result)}`);
  return { key: created.key ?? created.data?.key, created: true };
}

async function commandStatus() {
  const local = await localAvailable();
  const target = library();
  print({
    library: {
      kind: target.kind,
      id: target.id || null,
      note:
        target.kind === "group"
          ? "Working in a team library: everything filed here is visible to every group member."
          : "Working in the personal library. Set ZOTERO_GROUP_ID, or pass --group, to share the bibliography with a team.",
    },
    local: {
      reachable: local,
      base: process.env.ZOTERO_LOCAL_API || "http://localhost:23119/api",
      capability: "read-only",
      note: local
        ? "Zotero is running here; reads use it and need no key."
        : "No local Zotero. That is expected in a hosted sandbox — it needs Zotero 7 on the same machine with the local API enabled.",
    },
    web: {
      configured: webConfigured(),
      capability: "read and write",
      note: webConfigured()
        ? "Key present."
        : "Set ZOTERO_API_KEY plus ZOTERO_USER_ID or ZOTERO_GROUP_ID, from zotero.org/settings/keys.",
    },
  });
}

async function commandAdd(options) {
  if (!options.file) throw new ZoteroError("add needs --file with a CSL-JSON array (suniv-search --csl writes one)");
  const raw = JSON.parse(readFileSync(options.file, "utf8"));
  const works = Array.isArray(raw) ? raw : raw.items;
  if (!Array.isArray(works) || !works.length) throw new ZoteroError(`${options.file} holds no CSL-JSON items`);

  let collections = [];
  let collectionInfo = null;
  if (options.collection) {
    const resolved = await findCollectionKey(options.collection);
    collections = [resolved.key];
    collectionInfo = { name: options.collection, key: resolved.key, created: resolved.created };
  }

  const target = library();
  const payload = works.map((work) => cslToZotero(work, { collections, tags: options.tags }));
  const report = {
    library: { kind: target.kind, id: target.id || null },
    collection: collectionInfo,
    submitted: payload.length,
    created: [],
    failed: [],
  };

  for (const batch of chunk(payload, 50)) {
    const result = await writeApi("/items", batch);
    for (const [index, entry] of Object.entries(result?.successful || {})) {
      report.created.push({ key: entry.key ?? entry.data?.key, title: batch[Number(index)]?.title });
    }
    for (const [index, entry] of Object.entries(result?.failed || {})) {
      report.failed.push({ title: batch[Number(index)]?.title, reason: entry.message || JSON.stringify(entry) });
    }
    for (const index of Object.keys(result?.unchanged || {})) {
      report.failed.push({ title: batch[Number(index)]?.title, reason: "unchanged — Zotero already holds this item" });
    }
  }
  print(report);
}

async function commandTag(options) {
  if (!options.item || !options.tags.length) throw new ZoteroError("tag needs --item KEY and at least one --tag");
  const { data } = await readApi(`/items/${options.item}`, { preferLocal: false });
  const existing = data?.data?.tags || [];
  const merged = [...existing];
  for (const tag of options.tags) if (!merged.some((t) => t.tag === tag)) merged.push({ tag });
  await writeApi(`/items/${options.item}`, { version: data.version ?? data.data?.version, tags: merged }, "PATCH");
  print({ item: options.item, tags: merged.map((t) => t.tag) });
}

async function main() {
  const parsed = parseArgs(process.argv.slice(2));
  if (parsed.help) {
    process.stdout.write(`${USAGE}\n`);
    return 0;
  }
  if (parsed.error) {
    process.stderr.write(`suniv-zotero: ${parsed.error}\n\n${USAGE}\n`);
    return 2;
  }

  const { options } = parsed;
  if (options.group) selectedGroup = options.group;
  const [command, ...rest] = options._;

  try {
    switch (command) {
      case undefined:
      case "status":
        await commandStatus();
        return 0;
      case "collections": {
        const { via, library: kind, data } = await readApi("/collections?limit=100");
        print({
          via,
          library: kind,
          collections: (data || []).map((c) => ({ key: c.key ?? c.data?.key, name: c.data?.name ?? c.name })),
        });
        return 0;
      }
      case "search": {
        const terms = rest.join(" ");
        if (!terms) throw new ZoteroError("search needs terms");
        const { via, library: kind, data } = await readApi(`/items?q=${encodeURIComponent(terms)}&limit=50`);
        print({ via, library: kind, count: (data || []).length, items: data });
        return 0;
      }
      case "items": {
        const path = options.collection ? `/collections/${options.collection}/items?limit=100` : "/items?limit=100";
        const { via, library: kind, data } = await readApi(path);
        print({ via, library: kind, count: (data || []).length, items: data });
        return 0;
      }
      case "add":
        await commandAdd(options);
        return 0;
      case "tag":
        await commandTag(options);
        return 0;
      default:
        process.stderr.write(`suniv-zotero: unknown command "${command}"\n\n${USAGE}\n`);
        return 2;
    }
  } catch (err) {
    if (err instanceof ZoteroError) {
      process.stderr.write(`${err.message}\n`);
      return 1;
    }
    throw err;
  }
}

process.exitCode = await main();
